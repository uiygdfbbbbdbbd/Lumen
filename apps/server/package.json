{
  "name": "@lumen/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=@lumen/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@lumen/source src/db/migrate-cli.ts",
    "db:rollback": "tsx --conditions=@lumen/source src/db/rollback-cli.ts",
    "db:seed": "tsx --conditions=@lumen/source src/db/seed-cli.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/websocket": "^11.3.7",
    "@lumen/email-templates": "workspace:*",
    "@lumen/llm": "workspace:*",
    "@lumen/shared": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bullmq": "^6.7.0",
    "diff": "^9.0.0",
    "docx": "^9.15.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "file-type": "^22.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "nodemailer": "^7.0.13",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lumen/eslint-config": "workspace:*",
    "@lumen/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
