# Serves the web app and proxies /api to the server. Set SITE_ADDRESS to your domain for automatic HTTPS
# (e.g. SITE_ADDRESS=chat.example.com); defaults to plain HTTP on :80 for local use.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/* /v1/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:server:3000} {
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# The artifact runtime runs untrusted, AI-generated code in a sandboxed iframe (opaque origin). It may run
	# inline/eval'd scripts but has NO network access: every capability goes through the parent's postMessage bridge.
	# Any site may frame it (embedded public artifacts nest it), because it refuses to run unless sandboxed.
	@runtime path /artifact-runtime.html /runtime/*
	header @runtime {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; media-src data: blob:; connect-src 'none'; frame-ancestors *; form-action 'none'; base-uri 'none'"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# The browser code runner (sandboxed, opaque origin) loads Pyodide from here, so it needs CORS.
	@pyodide path /pyodide/*
	header @pyodide {
		Access-Control-Allow-Origin "*"
		Cross-Origin-Resource-Policy "cross-origin"
		Cache-Control "public, max-age=604800"
	}
	@runner path /code-runner.html /runner/*
	header @runner {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src blob:; connect-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Published artifacts (/a/*) can be embedded on other sites; everything else refuses framing.
	@public_artifact path /a/*
	header @public_artifact {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors *; form-action 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@app not path /artifact-runtime.html /runtime/* /a/* /code-runner.html /runner/*
	header @app {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@static path /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
