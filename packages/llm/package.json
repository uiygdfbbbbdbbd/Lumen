{
  "name": "@lumen/llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@lumen/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "@lumen/source": "./src/mock/server.ts",
      "types": "./dist/mock/server.d.ts",
      "default": "./dist/mock/server.js"
    }
  },
  "bin": {
    "lumen-mock-llm": "./dist/mock/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --coverage",
    "mock": "tsx src/mock/cli.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lumen/eslint-config": "workspace:*",
    "@lumen/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}