# --- Core ---
NODE_ENV=development
PRODUCT_NAME=Lumen
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# --- Data ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumen
REDIS_URL=redis://localhost:6379

# --- Secrets (generate your own!) ---
# openssl rand -base64 32   (comma-separate several keys; the first encrypts, the rest only decrypt -> key rotation)
ENCRYPTION_KEYS=
# openssl rand -base64 48
SESSION_SECRET=

# --- Storage: fs | s3 (MinIO in docker compose) ---
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=lumen
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email: smtp | log | memory ---
EMAIL_TRANSPORT=log
# SMTP_HOST=localhost
# SMTP_PORT=1025
EMAIL_FROM="Lumen <no-reply@localhost>"

# --- Signup / security ---
SIGNUP_MODE=open
HIBP_CHECK=false
CAPTCHA_PROVIDER=none
ALLOW_PRIVATE_PROVIDER_URLS=false
# Development/tests only: let web search/fetch and URL knowledge reach private addresses.
ALLOW_PRIVATE_FETCH=false
